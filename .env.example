# No secrets are needed to run this project. Every variable below is optional.

# API (ffai.serve): where artifacts live and which browser origins may call it.
FFAI_ARTIFACTS_DIR=./artifacts
FFAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Training / weekly job: where nflverse parquet downloads are cached (git-ignored).
FFAI_CACHE_DIR=./data/cache

# Frontend (frontend-next): the deployed API base URL.
NEXT_PUBLIC_API_URL=http://localhost:7860
