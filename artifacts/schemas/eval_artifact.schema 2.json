{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbratkovics/fantasy-football-ai/artifacts/schemas/eval_artifact.schema.json",
  "title": "Evaluation artifact (artifact_version 2.1)",
  "description": "One JSON per evaluation under artifacts/eval/<eval_id>.json, listed in manifest.evaluations. The API serves it verbatim; the model card, the site, and the dbt marts reconcile to it. Every metric is computed on the same rows; input.path is repository-relative. Produced by ffai.eval.evaluator.build_artifact.",
  "type": "object",
  "required": [
    "artifact_version",
    "eval_id",
    "kind",
    "season",
    "generated_at_utc",
    "code_commit",
    "input",
    "model",
    "metric_definitions",
    "split",
    "metrics",
    "baseline",
    "cohorts"
  ],
  "properties": {
    "artifact_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "eval_id": {
      "type": "string",
      "pattern": "^eval-"
    },
    "kind": {
      "enum": [
        "frozen_test",
        "out_of_sample_season"
      ]
    },
    "season": {
      "type": "integer"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "code_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "n_rows"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!/)(?![A-Za-z]:)",
          "description": "repo-relative, never absolute"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "n_rows": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "version",
        "feature_version",
        "candidate"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "feature_version": {
          "type": "string"
        },
        "candidate": {
          "description": "one candidate name, or a mapping cohort -> candidate",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "challenger": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "trained_at_utc": {
          "type": "string"
        },
        "input_sha256": {
          "type": "string"
        }
      }
    },
    "metric_definitions": {
      "type": "object",
      "required": [
        "mae",
        "within_3_rate",
        "baseline"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "split": {
      "type": "object",
      "required": [
        "strategy",
        "test_start_season",
        "test_start_week"
      ],
      "properties": {
        "strategy": {
          "const": "forward_time_holdout"
        },
        "test_start_season": {
          "type": "integer"
        },
        "test_start_week": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "n",
        "mae",
        "median_ae",
        "rmse",
        "within_3_rate",
        "within_5_rate"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "mae": {
          "type": [
            "number",
            "null"
          ]
        },
        "median_ae": {
          "type": [
            "number",
            "null"
          ]
        },
        "rmse": {
          "type": [
            "number",
            "null"
          ]
        },
        "within_3_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "within_5_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "baseline": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "n",
            "mae",
            "median_ae",
            "rmse",
            "within_3_rate",
            "within_5_rate"
          ],
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "mae": {
              "type": [
                "number",
                "null"
              ]
            },
            "median_ae": {
              "type": [
                "number",
                "null"
              ]
            },
            "rmse": {
              "type": [
                "number",
                "null"
              ]
            },
            "within_3_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "within_5_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ],
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "cohorts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "allOf": [
          {
            "type": "object",
            "required": [
              "n",
              "mae",
              "median_ae",
              "rmse",
              "within_3_rate",
              "within_5_rate"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "mae": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "median_ae": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rmse": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "within_3_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "within_5_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        ],
        "required": [
          "baseline"
        ],
        "properties": {
          "baseline": {
            "type": "object",
            "required": [
              "n",
              "mae",
              "median_ae",
              "rmse",
              "within_3_rate",
              "within_5_rate"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "mae": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "median_ae": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rmse": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "within_3_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "within_5_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "rolling_origin": {
      "type": "object",
      "required": [
        "candidate",
        "strategy",
        "folds",
        "mean_mae",
        "mean_baseline_mae"
      ],
      "properties": {
        "candidate": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        },
        "folds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "season",
              "week",
              "n",
              "mae",
              "baseline_mae"
            ],
            "properties": {
              "season": {
                "type": "integer"
              },
              "week": {
                "type": "integer"
              },
              "n": {
                "type": "integer"
              },
              "mae": {
                "type": "number"
              },
              "baseline_mae": {
                "type": "number"
              }
            }
          }
        },
        "mean_mae": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean_baseline_mae": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "policy_sweep": {
      "type": "array"
    }
  }
}
