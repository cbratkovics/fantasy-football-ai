{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbratkovics/fantasy-football-ai/artifacts/schemas/predictions_file.schema.json",
  "title": "Scored period file (predictions_version 1.0)",
  "description": "artifacts/predictions/<season>/week_<ww>.json, written by ffai.pipeline.score.score_week and updated in place by attach_actuals once the period has been played. Also the shape of the dbt source predictions_weekly.",
  "type": "object",
  "required": [
    "predictions_version",
    "season",
    "week",
    "model_version",
    "feature_version",
    "candidate",
    "generated_at_utc",
    "data_through",
    "scoring",
    "n",
    "predictions"
  ],
  "properties": {
    "predictions_version": {
      "const": "1.0"
    },
    "season": {
      "type": "integer"
    },
    "week": {
      "type": "integer",
      "minimum": 1
    },
    "model_version": {
      "type": "string"
    },
    "feature_version": {
      "type": "string"
    },
    "candidate": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "generated_at_utc": {
      "type": "string"
    },
    "actuals_attached_at_utc": {
      "type": "string"
    },
    "data_through": {
      "type": "object",
      "required": [
        "season",
        "week"
      ]
    },
    "scoring": {
      "type": "object",
      "required": [
        "model_target",
        "derivation",
        "interval"
      ]
    },
    "n": {
      "type": "integer",
      "minimum": 0
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "player_id",
          "position",
          "prediction",
          "floor",
          "ceiling",
          "candidate"
        ],
        "properties": {
          "player_id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "team": {
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "type": "string"
          },
          "prediction": {
            "type": "number"
          },
          "floor": {
            "type": "number",
            "minimum": 0
          },
          "ceiling": {
            "type": "number"
          },
          "receptions_estimate": {
            "type": "number"
          },
          "candidate": {
            "type": "string"
          },
          "actual": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
