{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbratkovics/fantasy-football-ai/artifacts/schemas/model_metadata.schema.json",
  "title": "Model version metadata",
  "description": "artifacts/models/<model_version>/metadata.json, written once by ffai.models.train.train_all. Records versions, split, input hash, code commit, per-cohort sample sizes, candidate metrics, and the drift reference (decile edges per week-of-season bucket).",
  "type": "object",
  "required": [
    "model_version",
    "feature_version",
    "sklearn_version",
    "data_library",
    "trained_at_utc",
    "data_through",
    "seasons",
    "target",
    "input_sha256",
    "input_rows",
    "code_commit",
    "interval_method",
    "candidates",
    "positions"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "pattern": "^[0-9]{8}-"
    },
    "feature_version": {
      "type": "string"
    },
    "ffai_version": {
      "type": "string"
    },
    "sklearn_version": {
      "type": "string"
    },
    "xgboost_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_library": {
      "type": "string"
    },
    "trained_at_utc": {
      "type": "string"
    },
    "data_through": {
      "type": "object",
      "required": [
        "season",
        "week"
      ]
    },
    "seasons": {
      "type": "object",
      "required": [
        "train",
        "val",
        "test"
      ],
      "properties": {
        "train": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "val": {
          "type": "integer"
        },
        "test": {
          "type": "integer"
        }
      }
    },
    "target": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_rows": {
      "type": "integer",
      "minimum": 1
    },
    "code_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "interval_method": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "positions": {
      "type": "object",
      "minProperties": 1,
      "description": "one entry per cohort (the key name is historical)",
      "additionalProperties": {
        "type": "object",
        "required": [
          "n_train",
          "n_val",
          "n_test",
          "n_features",
          "features",
          "champion",
          "candidates",
          "drift_reference"
        ],
        "properties": {
          "n_train": {
            "type": "integer"
          },
          "n_val": {
            "type": "integer"
          },
          "n_test": {
            "type": "integer"
          },
          "n_features": {
            "type": "integer"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "champion": {
            "type": "string"
          },
          "challenger": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseline_position_mean": {
            "type": "object"
          },
          "candidates": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "val_mae",
                "test_mae",
                "residual_quantiles",
                "top_feature_importance",
                "hyperparameters"
              ],
              "properties": {
                "val_mae": {
                  "type": "number"
                },
                "test_mae": {
                  "type": "number"
                },
                "residual_quantiles": {
                  "type": "object",
                  "required": [
                    "q",
                    "values"
                  ],
                  "properties": {
                    "q": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "top_feature_importance": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "hyperparameters": {
                  "type": "object"
                }
              }
            }
          },
          "drift_reference": {
            "type": "object",
            "required": [
              "bucket_weeks",
              "global",
              "buckets"
            ],
            "properties": {
              "bucket_weeks": {
                "type": "integer"
              },
              "global": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 11,
                  "maxItems": 11
                }
              },
              "buckets": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 11,
                    "maxItems": 11
                  }
                }
              }
            }
          }
        }
      }
    },
    "test_predictions_path": {
      "type": "string"
    }
  }
}
